{
  "name": "@nama/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:openapi": "tsx scripts/openapi-drift.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@nama/dashboard-types": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "yaml": "2.9.1"
  }
}
