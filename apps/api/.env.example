NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
SESSION_TTL_HOURS=12
# Runtime connection string for the nama_app role (non-superuser, enforced by RLS).
# Leave unset to use the seeded in-memory adapter for demos and tests.
APP_DATABASE_URL=
# 32-byte base64 value used to encrypt data-source credentials at rest.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# How often a shared realtime channel re-executes its query (milliseconds).
REALTIME_POLL_INTERVAL_MS=5000
DEMO_EDITOR_EMAIL=demo@nama.local
DEMO_EDITOR_PASSWORD=nama-demo-123
DEMO_VIEWER_EMAIL=viewer@nama.local
DEMO_VIEWER_PASSWORD=nama-viewer-123
