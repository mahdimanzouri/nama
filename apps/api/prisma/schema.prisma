// Nama persistence schema. Table names and columns mirror
// docs/architecture/data-model.md; RLS policies are appended to the initial
// migration by hand because Prisma cannot express PostgreSQL policies.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum MembershipStatus {
  invited
  active
  suspended

  @@map("membership_status")
}

enum ShareSubjectType {
  user
  role
  organization

  @@map("share_subject_type")
}

enum SharePermission {
  view
  edit

  @@map("share_permission")
}

enum DataSourceStatus {
  active
  disabled
  error

  @@map("data_source_status")
}

enum AuditActorType {
  user
  embed
  system

  @@map("audit_actor_type")
}

model User {
  id           String     @id @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model UserPreference {
  userId                String   @id @map("user_id") @db.Uuid
  locale                String
  theme                 String
  timezone              String
  defaultOrganizationId String?  @map("default_organization_id") @db.Uuid
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_preferences")
}

model Organization {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("organizations")
}

model Membership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("memberships")
}

model Role {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  isSystem       Boolean          @default(false) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions    RolePermission[]
  memberships    MembershipRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id              String           @id @db.Uuid
  name            String           @unique
  description     String
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String     @map("membership_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model Dashboard {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  name              String
  draftConfig       Json      @map("draft_config")
  publishedConfig   Json?     @map("published_config")
  revision          Int
  publishedRevision Int?      @map("published_revision")
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([organizationId, updatedAt])
  @@map("dashboards")
}

model DashboardVersion {
  id             String   @id @db.Uuid
  dashboardId    String   @map("dashboard_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  revision       Int
  config         Json
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([dashboardId, revision])
  @@index([dashboardId, createdAt])
  @@map("dashboard_versions")
}

model DashboardShare {
  id             String           @id @db.Uuid
  dashboardId    String           @map("dashboard_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  subjectType    ShareSubjectType @map("subject_type")
  subjectId      String           @map("subject_id") @db.Uuid
  permission     SharePermission
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([dashboardId, subjectType, subjectId])
  @@map("dashboard_shares")
}

model DataSource {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  kind           String
  config         Json
  allowRawSql    Boolean          @default(false) @map("allow_raw_sql")
  limits         Json
  status         DataSourceStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, name])
  @@map("data_sources")
}

model DataSourceCredential {
  id             String    @id @db.Uuid
  dataSourceId   String    @unique @map("data_source_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ciphertext     Bytes
  keyVersion     Int       @map("key_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt      DateTime? @map("rotated_at") @db.Timestamptz(6)

  @@map("data_source_credentials")
}

model WidgetDefinition {
  id            String   @id @db.Uuid
  type          String   @unique
  manifest      Json
  configVersion Int      @map("config_version")
  isBuiltin     Boolean  @default(false) @map("is_builtin")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("widget_definitions")
}

model EmbedToken {
  id             String    @id @db.Uuid
  dashboardId    String    @map("dashboard_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  tokenHash      Bytes     @unique @map("token_hash")
  issuedBy       String    @map("issued_by") @db.Uuid
  viewerIdentity String?   @map("viewer_identity")
  scope          Json
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([dashboardId, expiresAt])
  @@map("embed_tokens")
}

model AuditLog {
  id             String         @id @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String         @map("actor_id")
  action         String
  resourceType   String         @map("resource_type")
  resourceId     String?        @map("resource_id")
  metadata       Json
  requestId      String         @map("request_id")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@map("audit_logs")
}

// One row per Idempotency-Key per principal. `status` is `in-flight` while the
// original request runs and `completed` once the response is stored.
model IdempotencyKey {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  principalId    String   @map("principal_id") @db.Uuid
  key            String
  fingerprint    String
  method         String
  path           String
  status         String
  statusCode     Int?     @map("status_code")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([organizationId, principalId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// Sessions are global rather than tenant-scoped: the opaque token hash is the
// bearer credential and is looked up before an organization is known.
model Session {
  id             String   @id @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  csrfToken      String   @map("csrf_token")
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}
