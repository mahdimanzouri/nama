{
  "name": "@nama/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "tsdown": "0.23.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@nama/dashboard-types": "workspace:*"
  }
}
